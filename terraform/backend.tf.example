# Copy to backend.tf and replace the bucket value after creating the state bucket.
# S3 native lockfiles are used; DynamoDB locking is deprecated.
terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_UNIQUE_TERRAFORM_STATE_BUCKET"
    key          = "gitops-pilot/development/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
